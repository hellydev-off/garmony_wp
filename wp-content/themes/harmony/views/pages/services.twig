{% extends 'layouts/base.twig' %}

{% block title %}Услуги и цены — {{ siteName }}{% endblock %}

{% block content %}

<div class="cont-border-bottom">
  <div class="container">

    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="{{ site_url }}/">Главная</a> / Услуги
    </nav>

    <h1 class="page-title">Услуги и цены</h1>
    <p class="services-page__intro">Выберите направление, чтобы узнать подробности, цены и врачей — или сразу оставьте заявку, и мы подскажем, что подойдёт именно вам.</p>

    <div class="services-grid">

      <a href="{{ site_url }}/gynecology/" class="service-card">
        <img src="{{ theme_uri }}/assets/images/index/services/1.svg" alt="" class="service-card__icon">
        <p class="service-card__name">Акушерство и гинекология</p>
        <span class="service-card__link">Подробнее и цены</span>
      </a>

      <a href="{{ site_url }}/vedenie-beremennosti/" class="service-card">
        <img src="{{ theme_uri }}/assets/images/index/services/2.svg" alt="" class="service-card__icon">
        <p class="service-card__name">Индивидуальное ведение беременности</p>
        <span class="service-card__link">Подробнее</span>
      </a>

      <a href="{{ site_url }}/urologiya/" class="service-card">
        <img src="{{ theme_uri }}/assets/images/index/services/3.svg" alt="" class="service-card__icon">
        <p class="service-card__name">Урология и андрология</p>
        <span class="service-card__link">Подробнее и цены</span>
      </a>

      <a href="{{ site_url }}/obshchaya-praktika/" class="service-card">
        <img src="{{ theme_uri }}/assets/images/index/services/4.svg" alt="" class="service-card__icon">
        <p class="service-card__name">Общая врачебная практика</p>
        <span class="service-card__link">Подробнее и цены</span>
      </a>

      <a href="{{ site_url }}/pediatriya/" class="service-card">
        <img src="{{ theme_uri }}/assets/images/index/services/1.svg" alt="" class="service-card__icon">
        <p class="service-card__name">Педиатрическое отделение</p>
        <span class="service-card__link">Подробнее и цены</span>
      </a>

      <a href="{{ site_url }}/uzi/" class="service-card">
        <img src="{{ theme_uri }}/assets/images/index/services/2.svg" alt="" class="service-card__icon">
        <p class="service-card__name">УЗИ</p>
        <span class="service-card__link">Подробнее и цены</span>
      </a>

      <a href="{{ site_url }}/endoskopiya/" class="service-card">
        <img src="{{ theme_uri }}/assets/images/index/services/3.svg" alt="" class="service-card__icon">
        <p class="service-card__name">Эндоскопия</p>
        <span class="service-card__link">Подробнее и цены</span>
      </a>

      <a href="{{ site_url }}/laboratoria/" class="service-card">
        <img src="{{ theme_uri }}/assets/images/index/services/4.svg" alt="" class="service-card__icon">
        <p class="service-card__name">Лабораторные исследования</p>
        <span class="service-card__link">Подробнее и цены</span>
      </a>

      <a href="{{ site_url }}/funkcionalnaya-diagnostika/" class="service-card">
        <img src="{{ theme_uri }}/assets/images/index/services/1.svg" alt="" class="service-card__icon">
        <p class="service-card__name">Функциональная диагностика</p>
        <span class="service-card__link">Подробнее и цены</span>
      </a>

      <a href="{{ site_url }}/fizioterapiya/" class="service-card">
        <img src="{{ theme_uri }}/assets/images/index/services/2.svg" alt="" class="service-card__icon">
        <p class="service-card__name">Физиотерапия / Озонотерапия</p>
        <span class="service-card__link">Подробнее</span>
      </a>

      <a href="{{ site_url }}/massazh/" class="service-card">
        <img src="{{ theme_uri }}/assets/images/index/services/3.svg" alt="" class="service-card__icon">
        <p class="service-card__name">Массаж</p>
        <span class="service-card__link">Подробнее и цены</span>
      </a>

      {% set other_services = [
        { name: 'Дневной стационар', icon: '4.svg' }
      ] %}

      {% for service in other_services %}
      <button type="button" class="service-card service-card--modal js-open-appointment-modal" data-request-type="Вопрос по услуге «{{ service.name }}»">
        <img src="{{ theme_uri }}/assets/images/index/services/{{ service.icon }}" alt="" class="service-card__icon">
        <p class="service-card__name">{{ service.name }}</p>
        <span class="service-card__link">Задать вопрос</span>
      </button>
      {% endfor %}

    </div>

  </div>
</div>

{% include 'partials/contact-cta.twig' %}

{% endblock %}
