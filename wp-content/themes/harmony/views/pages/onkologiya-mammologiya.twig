      </div>

      <div class="gyno-prices__cta">
        <a href="#" class="gyno-btn gyno-btn--filled js-open-appointment-modal" data-request-type="Запись на приём">Записаться на приём</a>
        <a href="#" class="gyno-btn gyno-btn--outline js-open-appointment-modal" data-request-type="Вопрос по услуге">Задать вопрос</a>
      </div>
    </div>
  </section>

  {# ── Врачи ────────────────────────────────────────────────────────────────────── #}
  <section class="gyno-doctors" id="vrachi">
    <div class="container">
      <h2 class="gyno-section-title">Онкологи-маммологи клиники «Гармония»:</h2>
      <div class="doctors-grid">

        {% for doctor in category_doctors %}
        <div class="s_dr-card" data-doctor-url="{{ doctor.link }}">
          <div class="s_dr-card__photo{{ doctor.meta('photo') ? '' : ' s_dr-card__photo--placeholder' }}">
            {% if doctor.meta('photo') %}
              <img src="{{ doctor.meta('photo').url }}" alt="{{ doctor.title }}">
            {% else %}
              <img src="{{ theme_uri }}/assets/images/doctors/alla.png" alt="">
            {% endif %}
          </div>
          <p class="s_dr-card__name">{{ doctor.title }}</p>
          <p class="s_dr-card__spec gyno-spec-link">{{ doctor.meta('specialization') }}</p>
        </div>
        {% endfor %}

      </div>
      <div class="gyno-doctors__footer list-footer">
        <nav class="pg"></nav>
      </div>
    </div>
  </section>

  {% include 'partials/reviews-slider.twig' with { title: 'Отзывы клиентов:' } %}
  </div>

  {# ── Как проходит приём ───────────────────────────────────────────────────────── #}
  <section class="gyno-examinations">
    <div class="container">
      <h2 class="gyno-section-title">Как проходит приём онколога-маммолога</h2>
      <p>Врач проводит осмотр и пальпацию молочных желёз, уточняет жалобы и наличие факторов риска.</p>
      <p>При обнаружении уплотнений или изменений может быть назначена биопсия или направление на дополнительные исследования (УЗИ, маммографию).</p>

      <h3 class="gyno-subsection-title">Обследование может включать:</h3>
      <div class="gyno-steps">
        <div class="gyno-step">
          <div class="gyno-step__header">
            <div class="gyno-step__num">1</div>
            <div class="gyno-step__line"></div>
          </div>
          <p class="gyno-step__text">Осмотр и пальпация;</p>
        </div>
        <div class="gyno-step">
          <div class="gyno-step__header">
            <div class="gyno-step__num">2</div>
            <div class="gyno-step__line"></div>
          </div>
          <p class="gyno-step__text">УЗИ молочных желёз (при необходимости);</p>
        </div>
        <div class="gyno-step">
          <div class="gyno-step__header">
            <div class="gyno-step__num">3</div>
            <div class="gyno-step__line"></div>
          </div>
          <p class="gyno-step__text">Биопсия (по показаниям);</p>
        </div>
        <div class="gyno-step">
          <div class="gyno-step__header">
            <div class="gyno-step__num">4</div>
            <div class="gyno-step__line"></div>
          </div>
          <p class="gyno-step__text">Консультация по результатам обследования;</p>
        </div>
      </div>

      <div class="gyno-alert">
        <div class="gyno-alert__icon">!</div>
        <p>Не откладывайте визит к маммологу при обнаружении уплотнений — ранняя диагностика значительно повышает эффективность лечения.</p>
      </div>
    </div>
  </section>

  {# ── Вопросы и ответы ─────────────────────────────────────────────────────────── #}
  <section class="gyno-faq" id="voprosy">
    <div class="container">
      <h2 class="gyno-section-title">Вопросы и ответы:</h2>
      <div class="gyno-faq__list">
        <div class="gyno-faq__item">
          <button class="gyno-faq__question collapsed" data-toggle="collapse" data-target="#onk-faq-1" aria-expanded="false">
            <span>Почему стоит выбрать онколога-маммолога именно в Клинике «Гармония»?</span>
            <svg class="gyno-faq__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="collapse" id="onk-faq-1">
            <p class="gyno-faq__answer">Приём ведут опытные онкологи-маммологи, все необходимые процедуры — от осмотра до биопсии — можно пройти в одной клинике.</p>
          </div>
        </div>
        <div class="gyno-faq__item">
          <button class="gyno-faq__question collapsed" data-toggle="collapse" data-target="#onk-faq-2" aria-expanded="false">
            <span>Когда стоит обратиться к онкологу-маммологу?</span>
            <svg class="gyno-faq__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="collapse" id="onk-faq-2">
            <p class="gyno-faq__answer">При обнаружении уплотнений, боли, изменений формы груди или выделений из сосков, а также для профилактического осмотра.</p>
          </div>
        </div>
      </div>
      <div class="gyno-faq__actions">
        <a href="#" class="gyno-btn gyno-btn--filled js-open-appointment-modal" data-request-type="Запись на приём">Записаться на приём</a>
      </div>
    </div>
  </section>

  {% include 'partials/contact-cta.twig' %}

</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {

  new Swiper('.reviews-slider__swiper', {
    slidesPerView: 1,
    spaceBetween: 24,
    navigation: {
      prevEl: '.reviews-slider__prev',
      nextEl: '.reviews-slider__next',
    },
  });

  document.querySelectorAll('.gyno-faq__question').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      this.classList.toggle('is-open', !expanded);
    });
  });

  document.querySelectorAll('.gyno-subnav__link[href^="#"]').forEach(function (link) {
    link.addEventListener('click', function (e) {
      var target = document.querySelector(this.getAttribute('href'));
      if (target) {
        e.preventDefault();
        var top = target.getBoundingClientRect().top + window.pageYOffset - 80;
        window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      }
    });
  });

  // ─── Prices: data ─────────────────────────────────────────────────────────────
  var PRICES = [
    {name: 'Анестезия', price: '200'},
    {name: 'Аспирация лимфы в послеоперационной области', price: '1 000'},
    {name: 'Введение жидкости в экспандер', price: '950'},
    {name: 'Взятие мазка', price: '300'},
    {name: 'Диагностическая пункционная биопсия молочной железы', price: '2 100'},
    {name: 'Прием врача онколога-маммолога', price: '2 100'},
    {name: 'Прием врача онколога-маммолога Евстигнеева ИВ', price: '2 250'},
    {name: 'Снятие швов', price: '250'},
    {name: 'Соскоб с опуходи кожи (без стоимости цитологического исследования материала)', price: '900'},
    {name: 'Тонкоигольная аспирационная биопсия лимфатического узла/молочной железы (без стоимости цитологического исследования материала)', price: '1 500'},
    {name: 'Тонкоигольнаяя аспирационная биопсия лимфатическогоо узла/молочной железы под контролем ультразвукового исследования (без стоимости цитологического', price: '1 800'},
  ];

  var PER_PAGE   = 10;
  var curPage    = 1;
  var filtered   = PRICES;

  var tbody      = document.getElementById('prices-tbody');
  var pgNav      = document.getElementById('prices-pg');
  var searchInput = document.querySelector('.gyno-prices__search input');

  if (!tbody || !pgNav || !searchInput) return;

  function renderRows() {
    var start = (curPage - 1) * PER_PAGE;
    var page  = filtered.slice(start, start + PER_PAGE);

    if (!page.length) {
      tbody.innerHTML = '<tr><td colspan="2" style="padding:20px 0;color:#999;text-align:center;">Услуги не найдены</td></tr>';
      return;
    }

    tbody.innerHTML = page.map(function (item) {
      return '<tr><td>' + item.name + '</td><td>' + item.price + ' ₽</td></tr>';
    }).join('');
  }

  function renderPg() {
    var total = Math.max(1, Math.ceil(filtered.length / PER_PAGE));

    if (total <= 1) { pgNav.innerHTML = ''; return; }

    var nums;
    if (total <= 7) {
      nums = Array.from({length: total}, function (_, i) { return i + 1; });
    } else if (curPage <= 4) {
      nums = [1, 2, 3, 4, 5, '…', total];
    } else if (curPage >= total - 3) {
      nums = [1, '…', total - 4, total - 3, total - 2, total - 1, total];
    } else {
      nums = [1, '…', curPage - 1, curPage, curPage + 1, '…', total];
    }

    var prevSVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="15 18 9 12 15 6"></polyline></svg>';
    var nextSVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="9 18 15 12 9 6"></polyline></svg>';

    var html = '<a href="#" class="pg__item" data-dir="-1" aria-label="Назад">' + prevSVG + '</a>';

    nums.forEach(function (n) {
      if (n === '…') {
        html += '<span class="pg__item pg__item--dots">…</span>';
      } else {
        html += '<a href="#" class="pg__item' + (n === curPage ? ' pg__item--active' : '') + '" data-pg="' + n + '">' + n + '</a>';
      }
    });

    html += '<a href="#" class="pg__item pg__item--filled" data-dir="1" aria-label="Вперёд">' + nextSVG + '</a>';
    pgNav.innerHTML = html;

    pgNav.querySelectorAll('[data-pg]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        goTo(parseInt(this.getAttribute('data-pg')));
      });
    });

    pgNav.querySelectorAll('[data-dir]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        var next = curPage + parseInt(this.getAttribute('data-dir'));
        var total = Math.ceil(filtered.length / PER_PAGE);
        if (next >= 1 && next <= total) goTo(next);
      });
    });
  }

  function goTo(page) {
    curPage = page;
    renderRows();
    renderPg();
  }

  searchInput.addEventListener('input', function () {
    var q = this.value.trim().toLowerCase();
    filtered = q
      ? PRICES.filter(function (item) { return item.name.toLowerCase().indexOf(q) !== -1; })
      : PRICES;
    curPage = 1;
    renderRows();
    renderPg();
  });

  renderRows();
  renderPg();

});
</script>
{% endblock %}
