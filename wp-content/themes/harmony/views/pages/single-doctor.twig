{% extends 'layouts/base.twig' %}

{% block title %}{{ post.title }} — Врачи — {{ siteName }}{% endblock %}

{% block content %}
  <div class="cont-border-bottom">
    <div class="container">

      <nav class="breadcrumb-nav">
        <a href="{{ site_url }}/">Главная</a>
        <span class="breadcrumb-nav__sep">/</span>
        <a href="{{ site_url }}/doctors/">Врачи</a>
        <span class="breadcrumb-nav__sep">/</span>
        <span>{{ post.title }}</span>
      </nav>

      {# ─── Герой врача ────────────────────────────────────────────────────────── #}
      <div class="dp-hero">
        <div class="dp-hero__photo">
          {% if post.meta('photo') %}
            <img src="{{ post.meta('photo').url }}" alt="{{ post.title }}" />
          {% else %}
            <svg viewBox="0 0 80 100" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:65%;opacity:.22;display:block;margin:auto;">
              <ellipse cx="40" cy="30" rx="22" ry="24" fill="#BBBBBB" />
              <path d="M5 95C5 72 75 72 75 95" stroke="#BBBBBB" stroke-width="8" fill="none" stroke-linecap="round" />
            </svg>
          {% endif %}
        </div>

        <div class="dp-hero__info">
          <h1 class="dp-hero__name">{{ post.title }}</h1>

          {% if post.meta('specialization') %}
            <p class="dp-hero__spec-label">Специализация:</p>
            <p class="dp-hero__spec">{{ post.meta('specialization') }}</p>
          {% endif %}

          {% if post.meta('experience') or post.meta('price_from') %}
          <div class="dp-hero__meta">
            {% if post.meta('experience') %}
            <div class="dp-hero__meta-item">
              <span class="dp-hero__meta-label">Стаж:</span>
              <span class="dp-hero__meta-value">{{ post.meta('experience') }}</span>
            </div>
            {% endif %}
            {% if post.meta('price_from') %}
            <div class="dp-hero__meta-item">
              <span class="dp-hero__meta-label">Стоимость приема:</span>
              <span class="dp-hero__meta-value">{{ post.meta('price_from') }}</span>
            </div>
            {% endif %}
          </div>
          {% endif %}

          {% if doctor_avg_rating %}
          <div class="dp-hero__rating">
            <div class="stars" aria-label="Рейтинг {{ doctor_avg_rating }} из 5">
              {% set fullStars = doctor_avg_rating|round(0, 'floor') %}
              {% for i in 1..fullStars %}
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#c8a84b" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% endfor %}
            </div>
            <span class="dp-hero__rating-value">{{ doctor_avg_rating }}</span>
            <span class="dp-hero__rating-count">({{ doctor_reviews|length }} отзыв{{ doctor_reviews|length == 1 ? '' : (doctor_reviews|length < 5 ? 'а' : 'ов') }})</span>
          </div>
          {% endif %}

          <p class="dp-hero__reviews">
            {% if not doctor_avg_rating %}
              Нет отзывов
            {% endif %}
            <a href="#reviews" class="dp-hero__reviews-link js-toggle-review-form">Добавить отзыв</a>
          </p>

          <a href="#" class="dp-hero__btn js-open-appointment-modal" data-request-type="Запись на приём" data-doctor-id="{{ post.id }}">Записаться на прием</a>
        </div>
      </div>

      {# ─── Дипломы и сертификаты ──────────────────────────────────────────────── #}
      {% if post.meta('diplomas') or post.meta('accreditations') %}
      <section class="dp-section">
        <h2 class="dp-section__title">Дипломы и сертификаты:</h2>

        <div class="dp-diplomas">
          {% for diploma in post.meta('diplomas') %}
          <div class="dp-diplomas__row">
            <span class="dp-diplomas__year">{{ diploma.year }}</span>
            <span class="dp-diplomas__text">{{ diploma.text }}</span>
          </div>
          {% endfor %}

          {% for accred in post.meta('accreditations') %}
          <div class="dp-diplomas__row dp-diplomas__row--accred">
            <span class="dp-diplomas__year"></span>
            <span class="dp-diplomas__text">
              {% if accred.link %}
                <a href="{{ accred.link }}" class="dp-diplomas__accred-link">{{ accred.text }}</a>
              {% else %}
                <span class="dp-diplomas__accred-link">{{ accred.text }}</span>
              {% endif %}
            </span>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {# ─── Отзывы ─────────────────────────────────────────────────────────────── #}
      <section class="dp-section dp-reviews" id="reviews">
        <h2 class="dp-section__title">Отзывы о враче:</h2>
        {% if doctor_reviews %}
          <div class="reviews-list">
            {% for review in doctor_reviews %}
            {% set fullStars = review.meta('rating')|round(0, 'floor') %}
            <div class="review-card">
              <h2 class="review-card__name">{{ review.meta('author_name') }}</h2>
              <div class="review-card__meta">
                <div class="stars" aria-label="Рейтинг {{ review.meta('rating') }} из 5">
                  {% for i in 1..fullStars %}
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="#c8a84b" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  {% endfor %}
                </div>
                <span class="review-card__date">от {{ review.meta('review_date') }}</span>
              </div>
              <hr class="review-card__divider">
              <p class="review-card__text">{{ review.meta('review_text') }}</p>
            </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="dp-reviews__empty">У этого врача пока нет отзывов. Помогите другим пациентам — оставьте первый отзыв!</p>
        {% endif %}

        <a href="#" class="dp-reviews__btn js-toggle-review-form">Добавить отзыв</a>

        <form id="reviewForm" class="dp-review-form" data-doctor-id="{{ post.id }}" novalidate>
          <div class="harmony-modal__field">
            <label for="reviewAuthorName">Ваше имя</label>
            <input type="text" id="reviewAuthorName" name="author_name" required>
          </div>
          <div class="harmony-modal__field">
            <label>Оценка</label>
            <div class="star-rating-input">
              {% for i in [5, 4, 3, 2, 1] %}
                <input type="radio" name="rating" id="reviewRating{{ i }}" value="{{ i }}" {{ i == 5 ? 'checked' : '' }}>
                <label for="reviewRating{{ i }}">★</label>
              {% endfor %}
            </div>
          </div>
          <div class="harmony-modal__field">
            <label for="reviewText">Текст отзыва</label>
            <textarea id="reviewText" name="review_text" required></textarea>
          </div>
          <button type="submit" class="harmony-modal__submit">Отправить отзыв</button>
          <div class="harmony-modal__message" id="reviewFormMessage"></div>
        </form>
      </section>

    </div>
  </div>

  {% include 'partials/contact-cta.twig' %}
{% endblock %}
