{# ─── Общий шаблон для подстраниц УЗИ (используется через include из views/pages/uzi-*.twig) ───
   Обязательные переменные: title, intro, indications_title, indications
   Необязательные (если не заданы — соответствующий блок просто не выводится):
     hero_image        — url картинки intro-баннера (по умолчанию — общее фото УЗИ)
     indications_nav_label — короткая подпись первого пункта подменю (по умолчанию — indications_title)
     indications_as_checklist — true, чтобы первый блок рисовался галочками, а не цифрами
     checklist_title, checklist_nav_label, checklist_single, checklist — доп. чек-лист (массив строк)
     prep_title, prep_nav_label — заголовок/подпись раздела «Подготовка» (по умолчанию 'Подготовка';
                        так же используется для разделов вида «Проведение исследования»)
     prep_items       — «Подготовка» нумерованным списком (массив строк)
     prep             — «Подготовка» одним абзацем (старый формат, используется если prep_items не задан)
     prices_title, prices — таблица «Стоимость услуг» (массив {name, price, promo})
     doctors_title    — заголовок блока врачей (по умолчанию 'Врачи УЗИ клиники «Гармония»:')
     features_title, features — доп. блок текстом (массив абзацев)
     reviews_empty    — true, чтобы показать пустое состояние в блоке отзывов
#}
<div class="gyno-page">

  <div class="cont-border-bottom">
    <div class="gyno-page-header">
    <div class="container">
      <nav class="breadcrumb-nav">
        <a href="{{ site_url }}/">Главная</a>
        <span class="breadcrumb-nav__sep">/</span>
        <a href="{{ site_url }}/uzi/">УЗИ</a>
        <span class="breadcrumb-nav__sep">/</span>
        <span>{{ title }}</span>
      </nav>
      <h1 class="page-title">{{ title }}</h1>
    </div>
  </div>

  <section class="gyno-intro">
    <div class="container">
      <div class="gyno-intro__bg">
        <nav class="gyno-subnav__inner js-sticky-subnav">
        <a href="#povod" class="gyno-subnav__link">{{ indications_nav_label|default(indications_title) }}</a>
        <a href="#zabota" class="gyno-subnav__link">С заботой о вас</a>
        {% if checklist %}<a href="#oblast" class="gyno-subnav__link">{{ checklist_nav_label|default('Область обследования') }}</a>{% endif %}
        {% if prep or prep_items %}<a href="#podgotovka" class="gyno-subnav__link">{{ prep_nav_label|default(prep_title|default('Подготовка')) }}</a>{% endif %}
        {% if prices %}<a href="#stoimost" class="gyno-subnav__link">Стоимость</a>{% endif %}
        <a href="#vrachi" class="gyno-subnav__link">Врачи</a>
        <a href="#otzyvy" class="gyno-subnav__link">Отзывы</a>
        {% if features %}<a href="#osobennosti" class="gyno-subnav__link">Особенности</a>{% endif %}
        <a href="#" class="gyno-subnav__link js-open-appointment-modal" data-request-type="Запись на приём">Записаться на приём</a>
      </nav>
      <div class="gyno-subnav__placeholder js-sticky-subnav-placeholder"></div>
       <div class="gyno-intro__inner">
        <div class="gyno-intro__media">
          <div class="gyno-placeholder gyno-placeholder--intro">
            <img src="{{ hero_image|default(theme_uri ~ '/assets/images/gynecology/firstphoto.png') }}" alt="">
          </div>
        </div>
        <div class="gyno-intro__text">
          <p>{{ intro }}</p>
        </div>
      </div>
      </div>
    </div>
  </section>

  {# ── Показания ────────────────────────────────────────────────────────────────── #}
  <section class="gyno-reasons" id="povod">
    <div class="container">
      <h2 class="gyno-section-title">{{ indications_title }}</h2>
      <div class="gyno-reasons__grid">
        {% for item in indications %}
        <div class="gyno-reason-card{{ indications_as_checklist ? ' gyno-reason-card--check' : '' }}">
          {% if indications_as_checklist %}
            <img src="{{ theme_uri }}/assets/images/gynecology/checkmark.png" alt="" class="gyno-reason-card__check">
          {% else %}
            <span class="gyno-reason-card__num">{{ loop.index }}</span>
          {% endif %}
          <p>{{ item }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  </div>

  {# ── С заботой о вас ─────────────────────────────────────────────────────────── #}
  <section class="gyno-care" id="zabota">
    <div class="container">
      <h2 class="gyno-section-title">С заботой о вас</h2>
      <div class="gyno-care__grid">
        <div class="gyno-care__item">
          <div class="gyno-care__icon">
            <img src="{{ theme_uri }}/assets/images/uzi-sub/care-icons/thumb.png" alt="">
          </div>
          <h3>0% осуждения,<br>100% понимания</h3>
          <p>Доверие и уважение — основа нашей работы. Врачи Клиники не осуждают выбор пациенток, их внешность или состояние здоровья. Мы здесь, чтобы поддержать вас сейчас и вместе наметить путь к лучшему самочувствию и счастью.</p>
        </div>
        <div class="gyno-care__item">
          <div class="gyno-care__icon">
            <img src="{{ theme_uri }}/assets/images/uzi-sub/care-icons/clipboard.png" alt="">
          </div>
          <h3>Не назначаем лишнего</h3>
          <p>Наша практика исключает постановку сомнительных диагнозов и назначение лекарств без чётких показаний. Все решения врачей опираются на самые свежие клинические рекомендации — как отечественные, так и зарубежные.</p>
        </div>
        <div class="gyno-care__item">
          <div class="gyno-care__icon">
            <img src="{{ theme_uri }}/assets/images/uzi-sub/care-icons/heart.png" alt="">
          </div>
          <h3>Бережное отношение</h3>
          <p>Ваш комфорт для нас так же важен, как и успешное решение вопроса. Мы позаботились о мелочах: в кабинете вас ждут одноразовые носочки, юбочки и предметы личной гигиены — чтобы визит прошёл легко и приятно.</p>
        </div>
        <div class="gyno-care__item">
          <div class="gyno-care__icon">
            <img src="{{ theme_uri }}/assets/images/uzi-sub/care-icons/pin.png" alt="">
          </div>
          <h3>Всё в одном месте</h3>
          <p>Проведём все необходимые обследования: от первичного осмотра и анализов до УЗИ и консультаций профильных врачей. Вам не нужно ходить по разным учреждениям — всё доступно здесь и сейчас.</p>
        </div>
      </div>
    </div>
  </section>

  {% if checklist %}
  <div class="cont-border">
  <section class="gyno-reasons" id="oblast">
    <div class="container">
      <h2 class="gyno-section-title">{{ checklist_title }}</h2>
      <div class="gyno-reasons__grid{{ checklist_single ? ' gyno-reasons__grid--single' : '' }}">
        {% for item in checklist %}
        <div class="gyno-reason-card gyno-reason-card--check">
          <img src="{{ theme_uri }}/assets/images/gynecology/checkmark.png" alt="" class="gyno-reason-card__check">
          <p>{{ item }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  </div>
  {% endif %}

  {% if prep_items %}
  <section class="gyno-examinations" id="podgotovka">
    <div class="container">
      <h2 class="gyno-section-title">{{ prep_title|default('Подготовка') }}</h2>
      <div class="gyno-reasons__grid gyno-reasons__grid--single">
        {% for item in prep_items %}
        <div class="gyno-reason-card">
          <span class="gyno-reason-card__num">{{ loop.index }}</span>
          <p>{{ item }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% elseif prep %}
  <section class="gyno-examinations" id="podgotovka">
    <div class="container">
      <h2 class="gyno-section-title">{{ prep_title|default('Подготовка') }}</h2>
      <p>{{ prep }}</p>
    </div>
  </section>
  {% endif %}

  <div class="cont-border">

  {% if prices %}
  <section class="gyno-prices" id="stoimost">
    <div class="container">
      <h2 class="gyno-section-title">{{ prices_title|default('Стоимость услуг:') }}</h2>
      <div class="gyno-prices__search">
        <svg width="18" height="18" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M24.9777 22.7343L20.0527 17.8073C23.7377 12.8843 22.7327 5.90526 17.8087 2.22026C12.8847-1.46374 5.90569-0.459742 2.22069 4.46426C-1.46431 9.38826-0.459312 16.3663 4.46469 20.0513C8.41969 23.0113 13.8527 23.0113 17.8087 20.0513L22.7357 24.9783C23.3547 25.5973 24.3587 25.5973 24.9777 24.9783C25.5967 24.3593 25.5967 23.3553 24.9777 22.7363V22.7343ZM11.1777 19.1003C6.80069 19.1003 3.25369 15.5533 3.25369 11.1773C3.25369 6.80126 6.80069 3.25326 11.1777 3.25326C15.5537 3.25326 19.1017 6.80126 19.1017 11.1773C19.0977 15.5513 15.5527 19.0963 11.1777 19.1003Z" fill="#aaa"/>
        </svg>
        <input type="text" placeholder="Введите название услуги" class="js-uzi-sub-price-search">
      </div>

      <table class="gyno-prices__table">
        <thead>
          <tr>
            <th>Наименование услуги</th>
            <th>Стоимость, руб.</th>
          </tr>
        </thead>
        <tbody class="js-uzi-sub-price-tbody">
          {% for row in prices %}
          <tr{% if row.promo %} class="gyno-prices__row--promo"{% endif %}>
            <td>{% if row.promo %}<span class="gyno-prices__badge">Акция</span>{% endif %}{{ row.name }}</td>
            <td>{{ row.price }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="gyno-prices__cta">
        <a href="#" class="gyno-btn gyno-btn--filled js-open-appointment-modal" data-request-type="Запись на приём">Записаться на приём</a>
      </div>
    </div>
  </section>
  <script>
    (function () {
      var input = document.querySelector('.js-uzi-sub-price-search');
      var tbody = document.querySelector('.js-uzi-sub-price-tbody');
      if (!input || !tbody) return;
      var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        rows.forEach(function (row) {
          var name = row.children[0].textContent.toLowerCase();
          row.style.display = name.indexOf(q) !== -1 ? '' : 'none';
        });
      });
    })();
  </script>
  {% endif %}

  {# ── Врачи ────────────────────────────────────────────────────────────────────── #}
  <section class="gyno-doctors" id="vrachi">
    <div class="container">
      <h2 class="gyno-section-title">{{ doctors_title|default('Врачи УЗИ клиники «Гармония»:') }}</h2>
      <div class="doctors-grid">

        {% for doctor in category_doctors %}
        <div class="s_dr-card" data-doctor-url="{{ doctor.link }}">
          <div class="s_dr-card__photo{{ doctor.meta('photo') ? '' : ' s_dr-card__photo--placeholder' }}">
            {% if doctor.meta('photo') %}
              <img src="{{ doctor.meta('photo').url }}" alt="{{ doctor.title }}">
            {% else %}
              <svg viewBox="0 0 80 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="40" cy="30" rx="22" ry="24" fill="#BBBBBB" />
                <path d="M5 95C5 72 75 72 75 95" stroke="#BBBBBB" stroke-width="8" fill="none" stroke-linecap="round" />
              </svg>
            {% endif %}
          </div>
          <p class="s_dr-card__name">{{ doctor.title }}</p>
          <p class="s_dr-card__spec gyno-spec-link">{{ doctor.meta('specialization') }}</p>
        </div>
        {% endfor %}

      </div>
    </div>
  </section>

  {% include 'partials/reviews-slider.twig' with { title: 'Отзывы клиентов:', reviews_empty: reviews_empty|default(false) } %}

  {% if features %}
  <section class="gyno-examinations" id="osobennosti">
    <div class="container">
      <h2 class="gyno-section-title">{{ features_title }}</h2>
      {% for p in features %}
      <p>{{ p }}</p>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  </div>

</div>

{% include 'partials/contact-cta.twig' %}
