{# ─── Ключевые специалисты клиники ───────────────────────────────────────────── #}
<section class="key-specialists section">
  <div class="container">
    <h2 class="section-title">Ключевые специалисты клиники:</h2>
    <div class="featured-doctors__grid">
      {% for doctor in featured_doctors %}
      <div class="doctor-featured" data-doctor-url="{{ doctor.link }}">
        <div class="doctor-featured__photo">
          {% if doctor.meta('photo') %}
            <img src="{{ doctor.meta('photo').url }}" alt="{{ doctor.title }}" />
          {% endif %}
        </div>
        {% set name_parts = doctor.title|split(' ', 2) %}
        <div class="doctor-featured__info">
          <p class="doctor-featured__name">{{ name_parts[0] }}<br>{{ name_parts[1] }}</p>
          <p class="doctor-featured__role">{{ doctor.meta('specialization') }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
