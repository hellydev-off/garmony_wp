<header class="site-header">
  {% include 'partials/topbard.twig' %}

  <div class="header-main">
    <div class="container">
      <div class="header-main__inner">

        <a class="header-logo" href="{{ site_url }}/">
          <img src="{{ theme_uri }}/assets/images/header/logo.png" alt="Гармония" class="header-logo__icon" />
          <div class="header-logo__text">
            <!-- <img src="{{ theme_uri }}/assets/images/header/logo.png" alt="Гармония" class="header-logo__icon" /> -->
            <!-- <img src="{{ theme_uri }}/assets/images/header/h_logotext.svg" alt="Гармония" /> -->
            <!-- <span>Клиника мужского и женского здоровья</span> -->
          </div>
        </a>

        {% set services_menu_cols %}
          <div class="header-services-dropdown__col">
            <a {{ svc_href('/gynecology/') }}>Акушерство и гинекология</a>
            <a {{ svc_href('/vedenie-beremennosti/') }}>Индивидуальное ведение беременности</a>
            <a {{ svc_href('/urologiya/') }}>Урология и андрология</a>
            <a {{ svc_href('/obshchaya-praktika/') }}>Общая врачебная практика</a>
            <a {{ svc_href('/gastroenterologiya/') }}>Гастроэнтерология</a>
            <a {{ svc_href('/uzi/') }}>УЗИ</a>
            <a {{ svc_href('/pediatriya/') }}>Педиатрическое отделение</a>
            <a {{ svc_href('/endoskopiya/') }}>Эндоскопия</a>
            <a {{ svc_href('/laboratoria/') }}>Лабораторные исследования</a>
            <a {{ svc_href('/funkcionalnaya-diagnostika/') }}>Функциональная диагностика</a>
            <a {{ svc_href('/fizioterapiya/') }}>Физиотерапия / Озонотерапия</a>
            <a {{ svc_href('/massazh/') }}>Массаж</a>
            <a {{ svc_href('/dnevnoy-stacionar/') }}>Дневной стационар</a>
            <a {{ svc_href('/onkoskrining/') }}>Онкоскрининг</a>
          </div>
          <div class="header-services-dropdown__col">
            <span class="header-services-dropdown__col-title">Общая врачебная практика:</span>
            <a {{ svc_href('/allergologiya/') }}>Аллергология-иммунология</a>
            <a {{ svc_href('/nevrologiya/') }}>Неврология</a>
            <a {{ svc_href('/gematologiya/') }}>Гематология</a>
            <a {{ svc_href('/kardiologiya/') }}>Кардиология</a>
            <a {{ svc_href('/onkologiya-mammologiya/') }}>Онкология-маммология</a>
            <a {{ svc_href('/travmatologiya-ortopediya/') }}>Травматология-ортопедия</a>
            <a {{ svc_href('/otorinolaringologiya/') }}>Оториноларингология</a>
            <a {{ svc_href('/pediatr/') }}>Педиатрия</a>
            <a {{ svc_href('/pulmonologiya/') }}>Пульмонология</a>
            <a {{ svc_href('/terapiya/') }}>Терапия</a>
            <a {{ svc_href('/flebologiya/') }}>Флебология</a>
            <a {{ svc_href('/hirurgiya-endokrinologiya/') }}>Хирургия и эндокринология</a>
          </div>
        {% endset %}

        <nav class="header-nav">
          <ul class="header-nav__list">
            {% for item in primary_menu.items %}
              {% if item.link starts with site_url ~ '/services' %}
                <li class="header-nav__item header-nav__item--has-dropdown">
                  <a href="{{ item.link }}">{{ item.title }}</a>
                  <div class="header-services-dropdown">
                    {{ services_menu_cols }}
                  </div>
                </li>
              {% else %}
                <li><a href="{{ item.link }}">{{ item.title }}</a></li>
              {% endif %}
            {% endfor %}
            <li class="header-nav__icon-item">
              <button type="button" class="header-nav__icon-btn js-open-site-search" aria-label="Поиск"><img src="{{ theme_uri }}/assets/images/header/h_search.svg" alt="" /></button>
            </li>
            <li class="header-nav__icon-item">
              <button type="button" class="header-nav__icon-btn js-toggle-accessibility" aria-label="Версия для слабовидящих" aria-pressed="false"><img src="{{ theme_uri }}/assets/images/header/h_eye.svg" alt="" /></button>
            </li>
          </ul>
        </nav>

        <button type="button" class="header-burger" id="headerBurger" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobileMenu">
          <span></span>
          <span></span>
          <span></span>
        </button>

      </div>
    </div>
  </div>

  {# ── Мобильное меню ──────────────────────────────────────────────────────── #}
  <div class="mobile-menu" id="mobileMenu">
    <nav class="mobile-menu__nav">
      {% for item in primary_menu.items %}
        {% if item.link starts with site_url ~ '/services' %}
          <div class="mobile-menu__accordion">
            <button type="button" class="mobile-menu__accordion-toggle js-mobile-services-toggle" aria-expanded="false">
              <span>{{ item.title }}</span>
              <svg class="mobile-menu__accordion-chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 8 10 12 14 8"></polyline></svg>
            </button>
            <div class="mobile-menu__accordion-panel">
              {{ services_menu_cols }}
              <a href="{{ item.link }}" class="mobile-menu__accordion-all">Все услуги и цены</a>
            </div>
          </div>
        {% else %}
          <a href="{{ item.link }}">{{ item.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    <div class="mobile-menu__contacts">
      <a href="tel:+74822368433" class="mobile-menu__phone">+7 (4822) 36 84 33</a>
      <span class="mobile-menu__addr">г. Тверь, ул. Желябова, 75</span>
    </div>
    <div class="mobile-menu__actions">
      <a href="#" class="btn-appointment js-open-appointment-modal" data-request-type="Запись на приём">Записаться на прием</a>
    </div>
  </div>
  <div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>
</header>
