{# ─── Модалка «Добавить отзыв» (с выбором врача) ────────────────────────────── #}
<div class="harmony-modal-overlay" id="reviewModalOverlay">
  <div class="harmony-modal" role="dialog" aria-modal="true" aria-labelledby="reviewModalTitle">
    <button type="button" class="harmony-modal__close" id="reviewModalClose" aria-label="Закрыть">&times;</button>
    <h2 class="harmony-modal__title" id="reviewModalTitle">Оставить отзыв</h2>
    <p class="harmony-modal__subtitle">Расскажите о своём опыте — это поможет другим пациентам</p>

    <form id="reviewModalForm" novalidate>
      <div class="harmony-modal__field">
        <label for="reviewModalAuthorName">Ваше имя</label>
        <input type="text" id="reviewModalAuthorName" name="author_name" required>
      </div>

      <div class="harmony-modal__field">
        <label>Врач</label>

        <div class="doctor-select">
          <button type="button" class="doctor-select__trigger" aria-haspopup="listbox">
            <span class="doctor-select__trigger-text">Выберите врача</span>
            <svg class="doctor-select__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>

          <div class="doctor-select__panel">
            <input type="text" class="doctor-select__search" placeholder="Найти врача...">
            <ul class="doctor-select__list" role="listbox">
              {% for doctor in all_doctors %}
              <li class="doctor-select__option" data-value="{{ doctor.id }}" data-label="{{ doctor.title }}" data-search="{{ doctor.title|lower }} {{ doctor.meta('specialization')|lower }}">
                {% if doctor.meta('photo') %}
                  <img class="doctor-select__option-avatar" src="{{ doctor.meta('photo').url }}" alt="">
                {% else %}
                  <span class="doctor-select__option-avatar-placeholder"></span>
                {% endif %}
                <span class="doctor-select__option-info">
                  <strong>{{ doctor.title }}</strong>
                  {% if doctor.meta('specialization') %}<small>{{ doctor.meta('specialization') }}</small>{% endif %}
                </span>
              </li>
              {% endfor %}
            </ul>
            <div class="doctor-select__empty" style="display:none;">Врач не найден</div>
          </div>

          <select id="reviewModalDoctor" name="doctor_id" class="doctor-select__native" required>
            <option value="" disabled selected>Выберите врача</option>
            {% for doctor in all_doctors %}
              <option value="{{ doctor.id }}">{{ doctor.title }}</option>
            {% endfor %}
          </select>
        </div>
      </div>

      <div class="harmony-modal__field">
        <label>Оценка</label>
        <div class="star-rating-input">
          {% for i in [5, 4, 3, 2, 1] %}
            <input type="radio" name="review_modal_rating" id="reviewModalRating{{ i }}" value="{{ i }}" {{ i == 5 ? 'checked' : '' }}>
            <label for="reviewModalRating{{ i }}">★</label>
          {% endfor %}
        </div>
      </div>

      <div class="harmony-modal__field">
        <label for="reviewModalText">Текст отзыва</label>
        <textarea id="reviewModalText" name="review_text" required></textarea>
      </div>

      <button type="submit" class="harmony-modal__submit">Отправить отзыв</button>
      <div class="harmony-modal__message" id="reviewModalMessage"></div>
    </form>
  </div>
</div>
