<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ siteName }}{% endblock %}</title>

  {# Применяем режим «для слабовидящих» до отрисовки страницы, чтобы не было мигания темы #}
  <script>
    (function () {
      try {
        if (localStorage.getItem('harmonyAccessibilityMode') === '1') {
          document.documentElement.classList.add('accessibility-mode');
        }
      } catch (e) {}
    })();
  </script>

  {# Стили подключены через wp_enqueue_style() в functions.php #}
  {{ function('wp_head') }}
  {% block head %}{% endblock %}

  {# Виджет онлайн-записи 1C-Bitrix MedAPI — перенесён со старого сайта (garmonia-clinic.ru) #}
  <script src="https://medapi.1cbit.ru/static/loader/3.0/main.js" id="or-loader" type="module" token="harmony"></script>

  {# Яндекс.Метрика — тот же счётчик №14114974, что на старом сайте (garmonia-clinic.ru), для непрерывной статистики #}
  <script type="text/javascript">
     (function (d, w, c) {
         (w[c] = w[c] || []).push(function() {
             try {
                 w.yaCounter14114974 = new Ya.Metrika({
                     id:14114974,
                     clickmap:true,
                     trackLinks:true,
                     accurateTrackBounce:true,
                     webvisor:true
                 });
             } catch(e) { }
         });

         var n = d.getElementsByTagName("script")[0],
             s = d.createElement("script"),
             f = function () { n.parentNode.insertBefore(s, n); };
         s.type = "text/javascript";
         s.async = true;
         s.src = "https://mc.yandex.ru/metrika/watch.js";

         if (w.opera == "[object Opera]") {
             d.addEventListener("DOMContentLoaded", f, false);
         } else { f(); }
     })(document, window, "yandex_metrika_callbacks");
  </script>
  <noscript>
     <div><img src="https://mc.yandex.ru/watch/14114974" style="position:absolute; left:-9999px;" alt="" /></div>
  </noscript>
</head>
<body class="{% block body_class %}{% endblock %}">

  {# Контейнер для AJAX-уведомлений OpenCart (корзина / сравнение / избранное) #}
  <div id="alert"></div>

  {% include 'partials/header.twig' %}

  <main class="main-content">
    {% block content %}{% endblock %}
  </main>

  {% include 'partials/footer.twig' %}

  <button type="button" class="scroll-top-btn js-scroll-top" aria-label="Наверх">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>

  {# Плавающая кнопка обратного звонка — перенесена со старого сайта (garmonia-clinic.ru) #}
  <a href="#" class="callback-fab js-open-appointment-modal" data-request-type="Обратный звонок" aria-label="Обратный звонок">
    <span class="callback-fab__ring"></span>
    <span class="callback-fab__fill"></span>
    <span class="callback-fab__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
    </span>
  </a>

  {% include 'partials/appointment-modal.twig' %}
  {% include 'partials/review-modal.twig' %}
  {% include 'partials/search-modal.twig' %}

  {# Скрипты подключены через wp_enqueue_script() в functions.php — должны загрузиться до инициализации Swiper ниже #}
  {{ function('wp_footer') }}

  {% block scripts %}{% endblock %}
</body>
</html>
